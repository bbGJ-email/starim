NODE_ENV=development
PORT=3004
TRUST_PROXY=loopback

JWT_SECRET=change_me
JWT_EXPIRES_IN=7d

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=starim
DB_PASSWORD=change_me
DB_NAME=starim
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=10000

CORS_ORIGINS=http://localhost:3004,http://127.0.0.1:3004,http://localhost:8080

UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE=5242880
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/jpg,image/png,image/gif
UPLOAD_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.gif
UPLOAD_ENABLE_CLAMAV=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

IDENTITY_AUTH_URL=https://example.com/identity/auth

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=change_me
SMTP_FROM=StarIM <your_smtp_user@example.com>

EMAIL_CODE_EXPIRES_MINUTES=10
EMAIL_CODE_COOLDOWN_SECONDS=60
MESSAGE_RECALL_WINDOW_SECONDS=120

CONTENT_MODERATION_AI_ENDPOINT=https://example.com/v1
CONTENT_MODERATION_AI_KEY=your_ai_api_key
CONTENT_MODERATION_AI_MODEL=your_ai_model
CONTENT_MODERATION_EXTERNAL_API_ENDPOINT=https://example.com/sensitive-filter
CONTENT_MODERATION_EXTERNAL_API_TOKEN=your_external_api_token
CONTENT_MODERATION_TIMEOUT_MS=5000
CONTENT_MODERATION_BLOCKED_TEXT=检测到敏感内容，已自动屏蔽
