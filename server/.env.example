NODE_ENV=development
PORT=3004

JWT_SECRET=change_me
JWT_EXPIRES_IN=7d

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=starim
DB_PASSWORD=change_me
DB_NAME=starim
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT=10000

CORS_ORIGINS=http://localhost:3004,http://127.0.0.1:3004,http://localhost:8080

UPLOAD_DIR=uploads
UPLOAD_MAX_FILE_SIZE=5242880
UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/jpg,image/png,image/gif
UPLOAD_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.gif
UPLOAD_ENABLE_CLAMAV=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

IDENTITY_AUTH_URL=https://example.com/identity/auth

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=change_me
SMTP_FROM=StarIM <your_smtp_user@example.com>

EMAIL_CODE_EXPIRES_MINUTES=10
EMAIL_CODE_COOLDOWN_SECONDS=60
MESSAGE_RECALL_WINDOW_SECONDS=120
